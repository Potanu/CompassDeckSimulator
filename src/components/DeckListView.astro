---
import '../styles/deck-list-view.css';
import cards from "../data/cards/m_cards.json";
import cardRarities from "../data/cards/m_card_rarity_types.json";
import cardAttributeTypes from "../data/cards/m_card_attribute_types.json";
import cardAttributes from "../data/cards/m_card_attributes.json";
import cardStatuses from "../data/cards/m_card_statuses.json";
import cardSkills from "../data/cards/m_card_skill_types.json";
import cardElements from "../data/cards/m_card_element_types.json";
import cardCaterories from "../data/cards/m_card_category_types.json";
import cardCastTimes from "../data/cards/m_card_cast_time_types.json";

type CardAttributeTypeRow = (typeof cardAttributeTypes)[number];
type CardStatusRow = (typeof cardStatuses)[number];

type CardAttributeMap = Record<number, CardAttributeTypeRow | undefined>;
type CardStatusMap = Record<number, {
  cooldownTime: number;
  attack: number;
  defense: number;
  health: number;
  abilityLabel: string;
}>;

const cardRarityMap = Object.fromEntries(cardRarities.map((x) => [x.id, x]));
const cardAttributeTypeMap = Object.fromEntries(cardAttributeTypes.map((x) => [x.id, x]));
const cardSkillMap = Object.fromEntries(cardSkills.map((x) => [x.id, x]));
const cardElementMap = Object.fromEntries(cardElements.map((x) => [x.id, x]));
const cardCategoryMap = Object.fromEntries(cardCaterories.map((x) => [x.id, x]));
const cardCastTimeMap = Object.fromEntries(cardCastTimes.map((x) => [x.id, x]));

const cardAttributeMap: CardAttributeMap = {};
cardAttributes.forEach((attribute) => {
  if (!cardAttributeMap[attribute.cardId]) {
    cardAttributeMap[attribute.cardId] = cardAttributeTypeMap[attribute.cardAttributeTypeId];
  }
});

const cardStatusMap: CardStatusMap = {};
cardStatuses.forEach((x) => {
  cardStatusMap[x.card_id] = {
    cooldownTime: x.cooldownTime,
    attack: x.attack,
    defense: x.defense,
    health: x.health,
    abilityLabel: x.abilityLabel,
  };
});

const maxAttack = Math.max(...cards.map((card) => cardStatusMap[card.id]?.attack ?? 0), 0);
const maxDefense = Math.max(...cards.map((card) => cardStatusMap[card.id]?.defense ?? 0), 0);
const maxHealth = Math.max(...cards.map((card) => cardStatusMap[card.id]?.health ?? 0), 0);

const getBarWidthPercent = (value: number, maxValue: number) => {
  if (!maxValue) return 0;
  return Math.max(4, Math.round((value / maxValue) * 100));
};
---

<div class="deck-list-view">
  {cards.map((card) => {
    const attackValue = cardStatusMap[card.id]?.attack ?? 0;
    const defenseValue = cardStatusMap[card.id]?.defense ?? 0;
    const healthValue = cardStatusMap[card.id]?.health ?? 0;
    const attackWidth = getBarWidthPercent(attackValue, maxAttack);
    const defenseWidth = getBarWidthPercent(defenseValue, maxDefense);
    const healthWidth = getBarWidthPercent(healthValue, maxHealth);

    return (
    <details
      class="item"
      data-card-id={card.id}
      data-element-id={card.cardElementId}
      data-rarity-id={card.cardRarityId}
      data-skill-id={card.cardSkillId}
      data-category-id={card.cardCategoryId}
      data-attack={cardStatusMap[card.id]?.attack ?? 0}
      data-defense={cardStatusMap[card.id]?.defense ?? 0}
      data-health={cardStatusMap[card.id]?.health ?? 0}
      data-card-label={card.label}
      data-card-skill-label={cardStatusMap[card.id]?.abilityLabel ?? ""}
      data-card-cooldown={cardStatusMap[card.id]?.cooldownTime ?? 0}
      data-card-cast-time={cardCastTimeMap[card.cardCastTimeId]?.label ?? ""}
      data-card-attack={cardStatusMap[card.id]?.attack ?? 0}
      data-card-defense={cardStatusMap[card.id]?.defense ?? 0}
      data-card-health={cardStatusMap[card.id]?.health ?? 0}
    >

      <summary>
        <span class={`rarity rarity-${card.cardRarityId}`}>
          {cardRarityMap[card.cardRarityId].label}
        </span>
        <span class="name">
          {card.label}
          <span class={`dot dot-${card.cardElementId}`}></span>
        </span>
        <span class="attribute-type">
          {cardAttributeMap[card.id]?.label ?? "不明"}
        </span>
      </summary>

      <div class="detail">

      <div class="info-row skill-row">
        <span class="title">スキル</span>
        <span>{cardStatusMap[card.id]?.abilityLabel ?? ""}</span>
      </div>

      <div class="info-row cooldown-row">
        <span class="title">クール</span>
        <span>{cardStatusMap[card.id]?.cooldownTime ?? 0}秒</span>

        <span class="title">発動時間</span>
        <span>{cardCastTimeMap[card.cardCastTimeId].label}</span>
      </div>

      <div class="status">
        <div class="status-row">
          <span>攻撃</span>
          <div class="bar">
            <div
              class="fill atk"
              style={`width:${attackWidth}%`}
            ></div>
          </div>
          <span>{attackValue}</span>
        </div>

        <div class="status-row">
          <span>防御</span>
          <div class="bar">
            <div
              class="fill def"
              style={`width:${defenseWidth}%`}
            ></div>
          </div>
          <span>{defenseValue}</span>
        </div>

        <div class="status-row">
          <span>体力</span>
          <div class="bar">
            <div
              class="fill hp"
              style={`width:${healthWidth}%`}
            ></div>
          </div>
          <span>{healthValue}</span>
        </div>
      </div>

      <div class="button-row">
        <button class="use-btn">
          使う
        </button>
      </div>

    </div>
    </details>
    );
  })}
</div>

<div class="display-panel-overlay" aria-hidden="true">
  <div class="display-panel">
    <div class="panel-header">
      <h2>カード検索</h2>
      <button class="panel-close-btn" type="button">×</button>
    </div>
    <div class="panel-body">
      <section class="panel-section">
        <div class="section-title">検索</div>
        <label class="search-input-wrap" for="card-search-input">
          <span class="search-input-icon" aria-hidden="true">🔎</span>
          <input
            id="card-search-input"
            class="search-input"
            type="text"
            placeholder="カード名やスキルで検索"
            autocomplete="off"
          />
        </label>
      </section>
      <section class="panel-section">
        <div class="section-title">属性</div>
        <div class="chips-row">
          {cardElements.map((option) => (
            <button type="button" class="chip" data-filter-group="element" data-filter-value={option.id}>{option.label}</button>
          ))}
        </div>
      </section>
      <section class="panel-section">
        <div class="section-title">レアリティ</div>
        <div class="chips-grid">
          {cardRarities.map((option) => (
            <button type="button" class="chip" data-filter-group="rarity" data-filter-value={option.id}>{option.label}</button>
          ))}
        </div>
      </section>
      <section class="panel-section">
        <div class="section-title">スキル</div>
        <div class="chips-grid">
          {cardSkills.map((option) => (
            <button type="button" class="chip" data-filter-group="skill" data-filter-value={option.id}>{option.label}</button>
          ))}
        </div>
      </section>
      <section class="panel-section">
        <div class="section-title">種類</div>
        <div class="chips-grid">
          {cardCaterories.map((option) => (
            <button type="button" class="chip" data-filter-group="category" data-filter-value={option.id}>{option.label}</button>
          ))}
        </div>
      </section>
      <section class="panel-section panel-bottom-section">
        <div class="section-title">並び順</div>
        <div class="sort-row">
          <select>
            <option value="標準">標準</option>
            <option value="レアリティ順">レアリティ順</option>
            <option value="攻撃力">攻撃力</option>
            <option value="防御力">防御力</option>
            <option value="体力順">体力順</option>
          </select>
          <button type="button" class="reset-btn">リセット</button>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="button-area">
    <button class="display-toggle-btn">表示変更</button>
</div>

<script>
const detailElements = document.querySelectorAll<HTMLDetailsElement>(".item");

detailElements.forEach((detail) => {
    detail.addEventListener("toggle", () => {
        if (!detail.open) return;

        document.querySelectorAll<HTMLDetailsElement>(".item").forEach((other) => {
            if (other !== detail) {
                other.open = false;
            }
        });

        const cardId = detail.dataset.cardId;
        const cardLabel = detail.dataset.cardLabel || "";
        const skillLabel = detail.dataset.cardSkillLabel || "";
        const cooldown = detail.dataset.cardCooldown || "0";
        const castTime = detail.dataset.cardCastTime || "";
        const attack = detail.dataset.cardAttack || "0";
        const defense = detail.dataset.cardDefense || "0";
        const health = detail.dataset.cardHealth || "0";

        const detailState = {
            cardId,
            cardLabel,
            skillLabel,
            cooldown,
            castTime,
            attack,
            defense,
            health,
        };

        document.dispatchEvent(new CustomEvent("deck-list:select-card", { detail: detailState }));
    });
});

const overlay = document.querySelector<HTMLDivElement>(".display-panel-overlay");
const openDisplayButton = document.querySelector<HTMLButtonElement>(".display-toggle-btn");
const closeDisplayButton = document.querySelector<HTMLButtonElement>(".panel-close-btn");
const chips = document.querySelectorAll<HTMLButtonElement>(".display-panel .chip");
const resetButton = document.querySelector<HTMLButtonElement>(".reset-btn");
const sortSelect = document.querySelector<HTMLSelectElement>(".sort-row select");
const searchInput = document.querySelector<HTMLInputElement>(".search-input");

const useButtons = document.querySelectorAll<HTMLButtonElement>(".use-btn");
useButtons.forEach((button) => {
    button.addEventListener("click", () => {
        const item = button.closest<HTMLDetailsElement>(".item");
        const cardId = Number(item?.dataset.cardId ?? 0);

        if (!cardId) {
            return;
        }

        document.dispatchEvent(new CustomEvent("deck-list:use-card", {
            detail: { cardId },
        }));

        document.getElementById("deckListOverlay")?.classList.add("hidden");
    });
});
const filterGroupMap: Record<string, string> = {
    element: "elementId",
    rarity: "rarityId",
    skill: "skillId",
    category: "categoryId",
};

openDisplayButton?.addEventListener("click", () => {
    overlay?.classList.add("open");
    overlay?.setAttribute("aria-hidden", "false");
});

const getActiveChipValues = () => {
    const activeGroups: Record<string, number[]> = {};

    chips.forEach((chip) => {
        if (!chip.classList.contains("active")) return;

        const group = chip.dataset.filterGroup;
        const value = Number(chip.dataset.filterValue ?? 0);
        if (!group || !value) return;

        if (!activeGroups[group]) {
            activeGroups[group] = [];
        }
        activeGroups[group].push(value);
    });

    return activeGroups;
};

const applyFilters = () => {
    const parent = document.querySelector<HTMLDivElement>(".deck-list-view");
    if (!parent) return;

    const query = searchInput?.value.trim().toLowerCase() ?? "";
    const activeGroups = getActiveChipValues();
    const items = Array.from(parent.querySelectorAll<HTMLDetailsElement>(".item"));

    items.forEach((item) => {
        const cardLabel = item.dataset.cardLabel?.toLowerCase() ?? "";
        const skillLabel = item.dataset.cardSkillLabel?.toLowerCase() ?? "";
        const matchesSearch = !query || cardLabel.includes(query) || skillLabel.includes(query);

        const matchesGroups = Object.entries(activeGroups).every(([group, values]) => {
            const fieldName = filterGroupMap[group];
            const itemValue = Number((item.dataset as Record<string, string>)[`${fieldName}`] ?? 0);
            return values.includes(itemValue);
        });

        item.style.display = matchesSearch && matchesGroups ? "" : "none";
    });
};

const sortItems = () => {
    const parent = document.querySelector<HTMLDivElement>(".deck-list-view");
    if (!parent || !sortSelect) return;

    const order = sortSelect.value;
    const items = Array.from(parent.querySelectorAll<HTMLDetailsElement>(".item"));

    const compare = (a: HTMLDetailsElement, b: HTMLDetailsElement) => {
        const aRarity = Number(a.dataset.rarityId ?? 0);
        const bRarity = Number(b.dataset.rarityId ?? 0);
        const aAttack = Number(a.dataset.attack ?? 0);
        const bAttack = Number(b.dataset.attack ?? 0);
        const aDefense = Number(a.dataset.defense ?? 0);
        const bDefense = Number(b.dataset.defense ?? 0);
        const aHealth = Number(a.dataset.health ?? 0);
        const bHealth = Number(b.dataset.health ?? 0);

        switch (order) {
            case "レアリティ順":
                return bRarity - aRarity;
            case "攻撃力":
                return bAttack - aAttack;
            case "防御力":
                return bDefense - aDefense;
            case "体力順":
                return bHealth - aHealth;
            default:
                return 0;
        }
    };

    if (order === "標準" || order === "カードレベル順" || order === "所持数順" || order === "入手順") {
        return;
    }

    items.sort(compare);
    items.forEach((item) => parent.appendChild(item));
};

closeDisplayButton?.addEventListener("click", () => {
    applyFilters();
    overlay?.classList.remove("open");
    overlay?.setAttribute("aria-hidden", "true");
    sortItems();
});

chips.forEach((chip) => {
    chip.addEventListener("click", () => {
        chip.classList.toggle("active");
    });
});

resetButton?.addEventListener("click", () => {
    chips.forEach((chip) => chip.classList.remove("active"));
    if (sortSelect) {
        sortSelect.selectedIndex = 0;
    }
    if (searchInput) {
        searchInput.value = "";
    }
    applyFilters();
});
</script>