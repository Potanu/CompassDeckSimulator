---
import '../styles/role-icon.css';
import { HeroRoleType } from "../types/heros";
import { ImageAsset } from '../types/common';
import { getImageAssetById } from "../accessors/common/getData.ts";

const getAssetPath = (asset: ImageAsset) => {
  const imageAsset = getImageAssetById(asset);
  return imageAsset ? `/CompassDeckSimulator/${imageAsset.imagePath}` : '';
};

const BASE_ICON = getAssetPath(ImageAsset.HEXAGON);
const roleIcons: Record<HeroRoleType, string> = {
  [HeroRoleType.SPRINTER]: getAssetPath(ImageAsset.SHOES),
  [HeroRoleType.ATTACKER]: getAssetPath(ImageAsset.SWORD),
  [HeroRoleType.GUNNER]: getAssetPath(ImageAsset.WAND_STARS),
  [HeroRoleType.TANK]: getAssetPath(ImageAsset.SHIELD),
};

const props = Astro.props as { role?: HeroRoleType; size?: number };
const role = props.role ?? HeroRoleType.SPRINTER;
const size = props.size ?? 38;
---

<div
  class="role-icon"
  style={`width:${size}px; height:${size}px;`}
>
  <img src={BASE_ICON} class="role-icon-base" alt="" />
  <img src={roleIcons[role]} class="role-icon-front" alt="" />
</div>