---
import '../styles/medal-settings-panel.css';
import { ImageAsset } from '../types/common';
import { HeroMedalType, HeroMedalColorType } from "../types/heros";
import { getAllgetHeroRoleTypeById, getHeroMedalColorTypeById } from "../accessors/heros/getData.ts";
import { getImageAssetById } from "../accessors/common/getData.ts";
import MedalIcon from './MedalIcon.astro';
---
<div id="medal-settings" class="medal-panel is-hidden">
  <div class="panel-title">
    <span class="main">強化メダル</span>
    <span class="sub">【タップで変更】</span>
  </div>

  <div class="medal-row">
    <MedalIcon type={HeroMedalType.RESIST_STUN_UP}    level=1 color={HeroMedalColorType.SILVER} />
    <MedalIcon type={HeroMedalType.RESIST_SILENT_UP}  level=2 color={HeroMedalColorType.PURPLE} />
    <MedalIcon type={HeroMedalType.RESIST_POISON_UP}  level=3 color={HeroMedalColorType.GREEN}  />
  </div>
</div>

<script>
  // メダル本体
  const medalButtons = document.querySelectorAll('.medal-main-button');

  // +1〜3
  const levelButtons = document.querySelectorAll('.medal-level-button');

  // シート
  const medalSheet = document.getElementById('medalTypeSheet');
  const levelSheet = document.getElementById('medalLevelSheet');

  // メダル種類変更
  medalButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      e.stopPropagation();

      medalSheet?.classList.toggle('open');
      levelSheet?.classList.remove('open');
    });
  });

  // レベル変更
  levelButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      e.stopPropagation();

      levelSheet?.classList.toggle('open');
      medalSheet?.classList.remove('open');
    });
  });

  // 外側クリックで閉じる
  document.addEventListener('click', () => {
    medalSheet?.classList.remove('open');
    levelSheet?.classList.remove('open');
  });
</script>
