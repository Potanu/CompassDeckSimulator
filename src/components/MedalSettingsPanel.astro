---
import '../styles/medal-settings-panel.css';
import { HeroMedalType, HeroMedalColorType } from "../types/heros";
import MedalIcon from './MedalIcon.astro';
---
<div id="medal-settings" class="medal-panel is-hidden">
  <div class="panel-title">
    <span class="main">強化メダル</span>
    <span class="sub">【タップで変更】</span>
  </div>

  <div class="medal-row">
    <MedalIcon type={HeroMedalType.RESIST_STUN_UP}    level=1 color={HeroMedalColorType.SILVER} />
    <MedalIcon type={HeroMedalType.RESIST_SILENT_UP}  level=2 color={HeroMedalColorType.PURPLE} />
    <MedalIcon type={HeroMedalType.RESIST_POISON_UP}  level=3 color={HeroMedalColorType.GREEN}  />
  </div>
</div>

<script>
  const closeAllMenus = () => {
    document.querySelectorAll('.medal-level-menu.open, .medal-type-menu.open').forEach((menu) => {
      menu.classList.remove('open');
    });
  };

  document.querySelectorAll('.medal-icon').forEach((icon) => {
    const trigger = icon.querySelector('.medal-level-button');
    const menu = icon.querySelector('.medal-level-menu');
    const typeTrigger = icon.querySelector('.medal-main-button');
    const typeMenu = icon.querySelector('.medal-type-menu');
    const colorButton = icon.querySelector('.medal-color-button') as HTMLButtonElement | null;
    const iconBase = icon.querySelector('.base') as HTMLDivElement | null;
    const iconImage = icon.querySelector('.medal-main-button .front') as HTMLImageElement | null;
    const iconLabel = icon.querySelector('.medal-label');

    if (trigger && menu) {
      trigger.addEventListener('click', (event) => {
        event.stopPropagation();

        const isOpen = menu.classList.contains('open');
        closeAllMenus();

        if (!isOpen) {
          menu.classList.add('open');
        }
      });

      menu.querySelectorAll('.medal-level-option').forEach((option) => {
        option.addEventListener('click', (event) => {
          event.stopPropagation();

          const value = option.getAttribute('data-value');
          if (value) {
            trigger.textContent = `+${value}`;
          }

          menu.classList.remove('open');
        });
      });
    }

    if (colorButton) {
      colorButton.addEventListener('click', (event) => {
        event.stopPropagation();

        const colorIds = (colorButton.getAttribute('data-color-ids') ?? '')
          .split(',')
          .map((value) => Number(value))
          .filter((value) => !Number.isNaN(value));
        const colorValues = (colorButton.getAttribute('data-color-values') ?? '')
          .split(',')
          .filter(Boolean)
          .map((entry) => {
            const [id, color] = entry.split(':');
            return [Number(id), color] as const;
          });

        if (colorIds.length === 0 || colorValues.length === 0) {
          return;
        }

        const currentColor = Number(colorButton.getAttribute('data-color') ?? colorIds[0]);
        const currentIndex = colorIds.indexOf(currentColor);
        const nextIndex = (currentIndex + 1 + colorIds.length) % colorIds.length;
        const nextColor = colorIds[nextIndex];
        const nextColorValue = colorValues.find(([id]) => id === nextColor)?.[1] ?? '#999';

        colorButton.setAttribute('data-color', String(nextColor));

        colorButton.style.background = nextColorValue;

        if (iconBase) {
          iconBase.style.background = nextColorValue;
        }
      });
    }

    if (typeTrigger && typeMenu) {
      typeTrigger.addEventListener('click', (event) => {
        event.stopPropagation();

        const isOpen = typeMenu.classList.contains('open');
        closeAllMenus();

        if (!isOpen) {
          typeMenu.classList.add('open');
        }
      });

      typeMenu.querySelectorAll('.medal-type-option').forEach((option) => {
        option.addEventListener('click', (event) => {
          event.stopPropagation();

          const value = option.getAttribute('data-value');
          const label = option.getAttribute('data-label') ?? '不明';
          const imagePath = option.getAttribute('data-image-path') ?? '';
          const nextType = Number(value ?? 0);

          if (!Number.isNaN(nextType) && iconImage && imagePath) {
            iconImage.src = imagePath;
          }

          if (iconLabel) {
            iconLabel.textContent = label;
          }

          typeMenu.classList.remove('open');
        });
      });
    }
  });

  document.addEventListener('click', () => {
    closeAllMenus();
  });
</script>
