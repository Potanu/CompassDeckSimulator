---
import '../styles/deck-view.css';
import DeckListView from "./DeckListView.astro";
import {
  getAllCard,
  getAllCardCastTimeType,
  getAllCardSkillType,
  getCardElementTypeById,
  getCardSkillTypeById,
  getCardStatusDisplayByCardId,
} from "../accessors/cards/getData";
import { getImageAssetById } from "../accessors/common/getData";
import { CardElementType } from "../types/cards/CardElementType";
import { ImageAsset } from "../types/common/ImageAsset";
import heroMedalStats from "../data/heros/m_hero_medal_stats.json";

const cards = getAllCard();
const cardSkills = getAllCardSkillType();
const cardCastTimeTypes = getAllCardCastTimeType();
const cardSkillMap = Object.fromEntries(cardSkills.map((skill) => [skill.id, skill]));
const cardCastTimeTypeMap = Object.fromEntries(cardCastTimeTypes.map((castTimeType) => [castTimeType.id, castTimeType]));
const cardStatusDisplayData = cards.map((card) => ({
  cardId: card.id,
  ...getCardStatusDisplayByCardId(card.id),
}));
const levelOptions = [1, 20, 30, 40, 50, 60];
const cardLevelStatusMap = Object.fromEntries(
  cards.map((card) => [
    card.id,
    Object.fromEntries(levelOptions.map((level) => [String(level), getCardStatusDisplayByCardId(card.id, level)])),
  ])
);
const imageAssetIdByElementId: Record<number, number> = {
  [CardElementType.FIRE]: ImageAsset.CARD_RED,
  [CardElementType.WATER]: ImageAsset.CARD_BLUE,
  [CardElementType.WOOD]: ImageAsset.CARD_GREEN,
  [CardElementType.NONE]: ImageAsset.CARD_PURPLE,
};
const getAssetUrl = (relativePath: string) => {
  if (!relativePath) {
    return "";
  }

  const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  return `${basePath}${relativePath.replace(/^\/+/, "")}`;
};
const getDeckCardImagePath = (cardElementId: number) => {
  const elementTypeId = getCardElementTypeById(cardElementId)?.id;
  const assetId = elementTypeId != null ? imageAssetIdByElementId[elementTypeId] : undefined;
  const imageAsset = assetId != null ? getImageAssetById(assetId) : undefined;
  return imageAsset?.imagePath ? getAssetUrl(imageAsset.imagePath) : "";
};
const cardElementImagePaths = Object.fromEntries(
  cards.map((card) => [card.cardElementId, getDeckCardImagePath(card.cardElementId)])
);
const maxAttack = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).attack ?? 0), 0);
const maxDefense = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).defense ?? 0), 0);
const maxHealth = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).health ?? 0), 0);
const initialCards = [...cards]
  .sort((a, b) => a.id - b.id)
  .slice(0, 4);
---
<deck-view class="deck-view">
  <div class="deck-view-content">
    {initialCards.map((card, index) => {
      const status = cardStatusDisplayData.find((item) => item.cardId === card.id) ?? { cooldownTime: 0, attack: 0, defense: 0, health: 0, abilityLabel: "" };
      const cooldownTime = status.cooldownTime;
      const skillLabel = getCardSkillTypeById(card.cardSkillId)?.label ?? "";
      const imagePath = cardElementImagePaths[card.cardElementId] ?? "";

      return (
        <div class="deck" data-card-id={card.id} data-slot-index={index} data-level="1">
          <div class="deck-card-area">
            <button class="deck-card" type="button" data-card-element-id={card.cardElementId}>
              <img class="deck-card-image" src={imagePath} alt="" />
              <span class="deck-card-level">Lv.1</span>
            </button>
            <div class="deck-level-picker hidden" role="menu" aria-label="レベル選択">
              {levelOptions.map((level) => (
                <button class="deck-level-option" type="button" data-level={level}>Lv.{level}</button>
              ))}
            </div>
          </div>

          <div class="deck-info">
            <div class="deck-name">{card.label}</div>

            <div class="deck-status">
              <div class="deck-category">
                <span class="deck-tag">{skillLabel}</span>
              </div>
              <div class="deck-ct">
                <span class="deck-ct-label">CT</span>
                <span class="deck-ct-current">{cooldownTime}</span>
                <span class="deck-ct-default">({cooldownTime}秒)</span>
              </div>
            </div>
          </div>

          <div class="deck-actions">
            <button class="openDeckList" type="button">入れ替え</button>
            <button class="openDeckDescription" type="button">説明</button>
          </div>
        </div>
      );
    })}
  </div>
</deck-view>

<!-- モーダル -->
<div id="deckListOverlay" class="overlay hidden">
  <div class="overlay-content deck-list-overlay-content">
    <div class="deck-list-overlay-header">
      <h2>カード一覧</h2>
      <button class="closeDeckList" type="button" aria-label="閉じる">×</button>
    </div>
    <div class="deck-list-scroll-area">
      <DeckListView />
    </div>
  </div>
</div>

<div id="deckDescriptionOverlay" class="overlay hidden">
  <div class="overlay-content deck-description-content">
    <div class="deck-description-header">
      <button class="closeDeckDescription" type="button" aria-label="閉じる">×</button>
    </div>
    <div class="deck-description-body deck-list-view"></div>
  </div>
</div>

<script define:vars={{ cards, cardSkillMap, cardCastTimeTypeMap, cardStatusDisplayData, cardElementImagePaths, levelOptions, cardLevelStatusMap, maxAttack, maxDefense, maxHealth, heroMedalStats, cooldownReductionMedalType: 6 }}>
const overlay = document.getElementById("deckListOverlay");
const descriptionOverlay = document.getElementById("deckDescriptionOverlay");
const descriptionBody = descriptionOverlay?.querySelector(".deck-description-body");
const closeDeckListButton = overlay?.querySelector(".closeDeckList");
let selectedReplacementIndex = null;

const DECK_SLOTS_COOKIE = "deck_view_slots";
const HERO_LEVEL_COOKIE = "footer_hero_level";
const getPersistedCookie = (name) => {
  const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
  if (!match) return null;
  try {
    return JSON.parse(decodeURIComponent(match[1]));
  } catch {
    return null;
  }
};
const setPersistedCookie = (name, value) => {
  const encoded = encodeURIComponent(JSON.stringify(value));
  document.cookie = `${name}=${encoded};path=/;max-age=${60 * 60 * 24 * 365};samesite=lax`;
};

const getDeckElements = () => Array.from(document.querySelectorAll(".deck-view .deck"));
const heroMedalStatRows = Array.isArray(heroMedalStats) ? heroMedalStats : [];
const getCooldownPercentFromMedals = () => {
  const medalIcons = Array.from(document.querySelectorAll("#medal-settings .medal-icon"));

  return medalIcons.reduce((totalPercent, icon) => {
    const medalType = Number(icon.getAttribute("data-medal-type") ?? 0);
    const medalLevel = Number(icon.getAttribute("data-medal-level") ?? 1);
    const medalColor = Number(icon.getAttribute("data-medal-color") ?? 0);

    if (medalType !== cooldownReductionMedalType) {
      return totalPercent;
    }

    const sameColorCount = medalIcons.reduce((count, candidate) => {
      const candidateColor = Number(candidate.getAttribute("data-medal-color") ?? 0);
      return count + (candidateColor === medalColor ? 1 : 0);
    }, 0);

    const matchedStat = heroMedalStatRows.find((row) => {
      return row.heroMedalId === medalType && row.level === medalLevel && row.count === sameColorCount;
    });

    return totalPercent + (matchedStat?.percent ?? 0);
  }, 0);
};
const formatCooldownValue = (baseValue, percentTotal) => {
  const value = Number(baseValue ?? 0) * (1 - (Number(percentTotal ?? 0) / 100));
  return Number.isFinite(value) ? value.toFixed(1) : "0.0";
};
const getDeckLevel = (deckElement) => Number(deckElement.dataset.level ?? 1);
const setDeckLevel = (deckElement, level) => {
  deckElement.dataset.level = String(level);
  const levelPicker = deckElement.querySelector(".deck-level-picker");
  if (levelPicker) {
    levelPicker.querySelectorAll(".deck-level-option").forEach((option) => {
      option.classList.toggle("active", String(option.dataset.level) === String(level));
    });
  }
};
const getStatusForLevel = (cardId, level) => {
  const cardStatuses = cardLevelStatusMap[cardId] ?? {};
  const resolvedLevel = level in cardStatuses ? String(level) : (level <= 20 ? "1" : String(level));
  const selectedStatus = cardStatuses[resolvedLevel] ?? cardStatuses["1"];
  return selectedStatus ?? { cooldownTime: 0, attack: 0, defense: 0, health: 0, abilityLabel: "" };
};
const getTeamLevelMultiplier = (key, level) => {
  if (level <= 1) {
    return 1;
  }

  const rate = key === "attack" ? 0.1 : 0.15;
  return 1 + (rate * (level - 1) / 8);
};
const getTeamLevelAdjustedValue = (key, level, value) => {
  return Math.round(Number(value ?? 0) * getTeamLevelMultiplier(key, level));
};
const getLevelMultiplier = (key, level) => {
  if (level <= 1) {
    return 1;
  }

  const rate = key === "attack" ? 0.1 : 0.15;
  return 1 + (rate * (level - 1) / 8);
};
const getLevelAdjustedValue = (key, level, value) => {
  return Math.round(Number(value ?? 0) * getLevelMultiplier(key, level));
};
const getGaugeWidthPercent = (value, maxValue) => {
  if (!maxValue) return 0;
  return Math.max(4, Math.round((value / maxValue) * 100));
};

const renderDeckCard = (deckElement, card) => {
  const level = getDeckLevel(deckElement);
  const status = getStatusForLevel(card.id, level);
  const cooldownTime = status.cooldownTime;
  const cooldownPercent = getCooldownPercentFromMedals();
  const displayedCooldownTime = formatCooldownValue(cooldownTime, cooldownPercent);
  const skillLabel = cardSkillMap[card.cardSkillId]?.label ?? "";

  const deckButton = deckElement.querySelector(".deck-card");
  const deckImage = deckElement.querySelector(".deck-card-image");
  const deckLevelElement = deckElement.querySelector(".deck-card-level");
  const deckNameElement = deckElement.querySelector(".deck-name");
  const deckSkillElement = deckElement.querySelector(".deck-category .deck-tag");
  const cooldownCurrentElement = deckElement.querySelector(".deck-ct-current");
  const cooldownDefaultElement = deckElement.querySelector(".deck-ct-default");

  if (deckButton) {
    deckButton.dataset.cardElementId = String(card.cardElementId);
  }
  if (deckImage) {
    deckImage.src = cardElementImagePaths[card.cardElementId] ?? "";
    deckImage.alt = card.label;
  }
  if (deckLevelElement) {
    deckLevelElement.textContent = `Lv.${level}`;
  }
  if (deckNameElement) {
    deckNameElement.textContent = card.label;
  }
  if (deckSkillElement) {
    deckSkillElement.textContent = skillLabel;
  }
  if (cooldownCurrentElement) {
    cooldownCurrentElement.textContent = String(displayedCooldownTime);
  }
  if (cooldownDefaultElement) {
    cooldownDefaultElement.textContent = `(${cooldownTime}秒)`;
  }

  deckElement.dataset.cardId = String(card.id);
};

const refreshDeckCardDisplays = () => {
  getDeckElements().forEach((deckElement) => {
    const cardId = Number(deckElement.dataset.cardId ?? 0);
    const card = cards.find((item) => item.id === cardId);

    if (card) {
      renderDeckCard(deckElement, card);
    }
  });

  publishDeckState();
};

let selectedTeamLevel = (() => {
  const savedLevel = Number(getPersistedCookie(HERO_LEVEL_COOKIE) ?? 1);
  return Number.isFinite(savedLevel) && savedLevel >= 1 ? savedLevel : 1;
})();

const restoreDeckSlotsFromCookie = () => {
  const savedSlots = getPersistedCookie(DECK_SLOTS_COOKIE);
  if (!Array.isArray(savedSlots)) return;

  getDeckElements().forEach((deckElement) => {
    const slotIndex = Number(deckElement.dataset.slotIndex ?? -1);
    const entry = savedSlots[slotIndex];
    if (!entry) return;

    const card = cards.find((item) => item.id === entry.cardId);
    if (!card) return;

    const level = levelOptions.includes(entry.level) ? entry.level : 1;
    setDeckLevel(deckElement, level);
    renderDeckCard(deckElement, card);
  });
};
restoreDeckSlotsFromCookie();

const publishDeckState = () => {
  const deckElements = getDeckElements();
  const cardIds = deckElements
    .map((deck) => Number(deck.dataset.cardId ?? 0))
    .filter(Boolean);
  const cardLevels = deckElements
    .map((deck) => ({
      cardId: Number(deck.dataset.cardId ?? 0),
      level: getDeckLevel(deck),
    }))
    .filter((item) => Boolean(item.cardId));

  setPersistedCookie(DECK_SLOTS_COOKIE, cardLevels);

  const totals = cardLevels.reduce(
    (acc, item) => {
      const status = getStatusForLevel(item.cardId, item.level);
      acc.attack += getTeamLevelAdjustedValue("attack", selectedTeamLevel, status.attack ?? 0);
      acc.defense += getTeamLevelAdjustedValue("defense", selectedTeamLevel, status.defense ?? 0);
      acc.health += getTeamLevelAdjustedValue("health", selectedTeamLevel, status.health ?? 0);
      return acc;
    },
    { attack: 0, defense: 0, health: 0 },
  );

  document.dispatchEvent(new CustomEvent("deck-view:state-changed", {
    detail: { cardIds, cardLevels, totals, teamLevel: selectedTeamLevel },
  }));
};

const replaceDeckCard = (slotIndex, cardId) => {
  const deckElement = getDeckElements()[slotIndex];
  const card = cards.find((item) => item.id === cardId);

  if (!deckElement || !card) {
    return;
  }

  renderDeckCard(deckElement, card);
  publishDeckState();
};

const hideAllLevelSelects = () => {
  document.querySelectorAll(".deck-level-picker").forEach((picker) => {
    picker.classList.add("hidden");
    picker.style.position = "";
    picker.style.left = "";
    picker.style.top = "";
    picker.style.width = "";
	    picker.style.height = "";
	    picker.style.removeProperty("--level-option-height");
	    picker.style.removeProperty("--level-option-font-size");
    picker.style.zIndex = "";
  });
};

const showLevelSelect = (deckElement) => {
  const levelPicker = deckElement.querySelector(".deck-level-picker");
  const cardButton = deckElement.querySelector(".deck-card");
  const cardImage = deckElement.querySelector(".deck-card-image");
  if (levelPicker && (cardButton || cardImage)) {
    hideAllLevelSelects();

    const anchorRect = cardImage?.getBoundingClientRect() ?? cardButton?.getBoundingClientRect();
    if (!anchorRect) {
      return;
    }

    const width = Math.min(132, Math.max(112, anchorRect.width));
    const availableHeight = Math.max(180, window.innerHeight - 24);
    const pickerVerticalSpace = 20;
    const optionHeight = Math.min(48, Math.floor((availableHeight - pickerVerticalSpace) / levelOptions.length));
    const pickerHeight = (optionHeight * levelOptions.length) + pickerVerticalSpace;
    const optionFontSize = Math.min(16, Math.max(11, Math.round(optionHeight / 3)));
    const maxLeft = window.innerWidth - width - 12;
    const left = Math.min(Math.max(anchorRect.right + 8, 12), maxLeft);
    const top = Math.min(Math.max(anchorRect.top + 4, 12), Math.max(12, window.innerHeight - pickerHeight - 12));

    levelPicker.classList.remove("hidden");
    levelPicker.style.position = "fixed";
    levelPicker.style.left = `${left}px`;
    levelPicker.style.top = `${top}px`;
    levelPicker.style.width = `${width}px`;
	    levelPicker.style.height = `${pickerHeight}px`;
	    levelPicker.style.setProperty("--level-option-height", `${optionHeight}px`);
	    levelPicker.style.setProperty("--level-option-font-size", `${optionFontSize}px`);
    levelPicker.style.zIndex = "2147483647";

    const currentLevel = getDeckLevel(deckElement);
    levelPicker.querySelectorAll(".deck-level-option").forEach((option) => {
      option.classList.toggle("active", String(option.dataset.level) === String(currentLevel));
    });
  }
};

const hideLevelSelect = (deckElement) => {
  const levelPicker = deckElement.querySelector(".deck-level-picker");
  if (levelPicker) {
    levelPicker.classList.add("hidden");
    levelPicker.style.position = "";
    levelPicker.style.left = "";
    levelPicker.style.top = "";
    levelPicker.style.width = "";
	    levelPicker.style.height = "";
	    levelPicker.style.removeProperty("--level-option-height");
	    levelPicker.style.removeProperty("--level-option-font-size");
    levelPicker.style.zIndex = "";
  }
};

const updateDescriptionOverlay = (deckElement) => {
  if (!descriptionOverlay || !descriptionBody) {
    return;
  }

  const cardId = deckElement?.dataset.cardId;
  const card = cards.find((item) => String(item.id) === cardId);
  const sourceItem = cardId
    ? document.querySelector(`.deck-list-view .item[data-card-id="${cardId}"]`)
    : null;
  const level = Number(deckElement?.dataset.level ?? 1);

  if (!card || !descriptionOverlay || !descriptionBody) {
    return;
  }

  const { summary, detail } = createDescriptionContent(card, level, sourceItem);
  descriptionBody.replaceChildren(summary, detail);
};

const createDescriptionContent = (card, level, sourceItem) => {
  const status = getStatusForLevel(card.id, level);
  const summary = document.createElement("summary");
  const rarity = document.createElement("span");
  const name = document.createElement("span");
  const attribute = document.createElement("span");
  const dot = document.createElement("span");

  const sourceSummary = sourceItem?.querySelector("summary");
  const sourceRarity = sourceSummary?.querySelector(".rarity");
  const sourceName = sourceSummary?.querySelector(".name");
  const sourceAttribute = sourceSummary?.querySelector(".attribute-type");
  const sourceDot = sourceName?.querySelector(".dot");

  rarity.className = sourceRarity?.className ?? "rarity";
  rarity.textContent = sourceRarity?.textContent?.trim() ?? "";
  name.className = sourceName?.className ?? "name";
  name.textContent = sourceName?.textContent?.trim() ?? card.label;
  attribute.className = sourceAttribute?.className ?? "attribute-type";
  attribute.textContent = sourceAttribute?.textContent?.trim() ?? "";
  dot.className = sourceDot?.className ?? "dot";

  if (sourceName && sourceDot) {
    name.appendChild(dot);
    name.insertBefore(dot, name.firstChild);
  }

  summary.appendChild(rarity);
  summary.appendChild(name);
  summary.appendChild(attribute);

  const detail = document.createElement("div");
  detail.className = "detail";

  const attackValue = getLevelAdjustedValue("attack", level, status.attack ?? 0);
  const defenseValue = getLevelAdjustedValue("defense", level, status.defense ?? 0);
  const healthValue = getLevelAdjustedValue("health", level, status.health ?? 0);
  const attackWidth = getGaugeWidthPercent(attackValue, maxAttack);
  const defenseWidth = getGaugeWidthPercent(defenseValue, maxDefense);
  const healthWidth = getGaugeWidthPercent(healthValue, maxHealth);
  const castTimeLabel = cardCastTimeTypeMap[card.cardCastTimeId]?.label ?? "";

  detail.innerHTML = `
    <div class="info-row skill-row">
      <span class="title">スキル</span>
      <span>${status.abilityLabel}</span>
    </div>
    <div class="info-row cooldown-row">
      <span class="title">クール</span>
      <span>${status.cooldownTime ?? 0}秒</span>
      <span class="title">発動時間</span>
      <span>${castTimeLabel}</span>
    </div>
    <div class="status">
      <div class="status-row">
        <span>攻撃</span>
        <div class="bar"><div class="fill atk" style="width:${attackWidth}%"></div></div>
        <span>${attackValue}</span>
      </div>
      <div class="status-row">
        <span>防御</span>
        <div class="bar"><div class="fill def" style="width:${defenseWidth}%"></div></div>
        <span>${defenseValue}</span>
      </div>
      <div class="status-row">
        <span>体力</span>
        <div class="bar"><div class="fill hp" style="width:${healthWidth}%"></div></div>
        <span>${healthValue}</span>
      </div>
    </div>
  `;

  return { summary, detail };
};

document.addEventListener("click", (event) => {
  const target = event.target instanceof Element ? event.target : null;
  const deckButton = target?.closest(".deck-card");
  const levelOption = target?.closest(".deck-level-option");
  const levelPicker = target?.closest(".deck-level-picker");

  if (deckButton) {
    event.preventDefault();
    const deckElement = deckButton.closest(".deck");
    if (deckElement) {
      showLevelSelect(deckElement);
    }
    return;
  }

  if (levelOption) {
    const deckElement = levelOption.closest(".deck");
    if (deckElement) {
      const level = Number(levelOption.dataset.level || 1);
      setDeckLevel(deckElement, level);
      const cardId = Number(deckElement.dataset.cardId ?? 0);
      const card = cards.find((item) => item.id === cardId);

      if (card) {
        renderDeckCard(deckElement, card);
      }

      publishDeckState();
      hideLevelSelect(deckElement);
      updateDescriptionOverlay(deckElement);
    }
    return;
  }

  if (!levelPicker) {
    hideAllLevelSelects();
  }
});

const deckViewContainer = document.querySelector(".deck-view-content");
if (deckViewContainer) {
  const observer = new MutationObserver(() => {
    publishDeckState();
  });

  observer.observe(deckViewContainer, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ["data-card-id"],
  });
}

if (overlay) {
  const closeDeckList = () => {
    overlay.classList.add("hidden");
    selectedReplacementIndex = null;
  };

  document.querySelectorAll(".openDeckList").forEach((button) => {
    button.addEventListener("click", () => {
      const deckElement = button.closest(".deck");
      selectedReplacementIndex = Number(deckElement?.dataset.slotIndex ?? -1);

      if (selectedReplacementIndex >= 0) {
        overlay.classList.remove("hidden");
      }
    });
  });

  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) {
      closeDeckList();
    }
  });

  closeDeckListButton?.addEventListener("click", closeDeckList);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !overlay.classList.contains("hidden")) {
      closeDeckList();
    }
  });
}

const closeDescription = () => {
  descriptionOverlay?.classList.add("hidden");
  if (descriptionBody) {
    descriptionBody.replaceChildren();
  }
};

document.addEventListener("click", (event) => {
  const descriptionButton = event.target instanceof Element ? event.target.closest(".openDeckDescription") : null;
  if (!descriptionButton) {
    return;
  }

  event.preventDefault();
  event.stopPropagation();
  hideAllLevelSelects();

  const deckElement = descriptionButton.closest(".deck");
  const cardId = deckElement?.dataset.cardId;
  const card = cards.find((item) => String(item.id) === cardId);
  const sourceItem = cardId
    ? document.querySelector(`.deck-list-view .item[data-card-id="${cardId}"]`)
    : null;
  const level = Number(deckElement?.dataset.level ?? 1);

  if (!card || !descriptionOverlay || !descriptionBody) {
    return;
  }

  const { summary, detail } = createDescriptionContent(card, level, sourceItem);
  descriptionBody.replaceChildren(summary, detail);
  descriptionOverlay.classList.remove("hidden");
});

descriptionOverlay?.addEventListener("click", (event) => {
  if (event.target === descriptionOverlay || event.target.closest(".closeDeckDescription")) {
    closeDescription();
  }
});

document.addEventListener("deck-list:use-card", (event) => {
  const cardId = event.detail?.cardId;

  if (typeof cardId !== "number" || selectedReplacementIndex === null || selectedReplacementIndex < 0) {
    return;
  }

  replaceDeckCard(selectedReplacementIndex, cardId);
  overlay?.classList.add("hidden");
  selectedReplacementIndex = null;
});

document.addEventListener("medal-settings:changed", () => {
  refreshDeckCardDisplays();
});

document.addEventListener("footer:level-selected", (event) => {
  const level = Number(event.detail?.level ?? 1);
  if (!Number.isFinite(level) || level < 1) {
    return;
  }
  selectedTeamLevel = level;
  publishDeckState();
});

window.addEventListener("load", () => {
  refreshDeckCardDisplays();
});

requestAnimationFrame(() => {
  refreshDeckCardDisplays();
});
</script>

<style>
.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  display:flex;
  justify-content:center;
  align-items:center;
  z-index:9999;
}

.hidden{
  display:none;
}

.overlay-content{
  position:relative;
  width:90%;
  max-width:420px;
  max-height:90vh;
  overflow:auto;
  background:#fff;
  border-radius:12px;
  padding:16px;
}

.deck-list-overlay-content {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 90vh;
