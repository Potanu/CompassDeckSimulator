</deck-view>

<!-- モーダル -->
<div id="deckListOverlay" class="overlay hidden">
  <div class="overlay-content">
    <DeckListView />
  </div>
</div>

<script>
const overlay = document.getElementById("deckListOverlay");

if (overlay) {
  document.querySelectorAll<HTMLButtonElement>(".openDeckList").forEach((button) => {
    button.addEventListener("click", () => {
      overlay.classList.remove("hidden");
    });
  });

  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) {
      overlay.classList.add("hidden");
    }
  });
}
</script>

<style>
.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  display:flex;
  justify-content:center;
  align-items:center;
  z-index:9999;
}

.hidden{
  display:none;
}

.overlay-content{
  position:relative;
  width:90%;
  max-width:420px;
  max-height:90vh;
  overflow:auto;
  background:#fff;
  border-radius:12px;
  padding:16px;
}
</style>