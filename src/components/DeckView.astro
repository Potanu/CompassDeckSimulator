---
import '../styles/deck-view.css';
---
<deck-view class="deck-view">
  	<div class="deck-view-content">
		<div class="deck">
			<button class="deck-card">Lv.50</button>

			<div class="deck-info">
				<div class="deck-name">
					とある家庭用メカの反乱
				</div>

				<div class="deck-status">
					<div class="deck-category">
						<span class="deck-tag">連続</span>
					</div>
					<div class="deck-ct">
						<span class="deck-ct-label">CT</span>
						<span class="deck-ct-current">21.5</span>
						<span class="deck-ct-default">(24秒)</span>
					</div>
				</div>
			</div>

