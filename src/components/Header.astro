---
import '../styles/header.css';
import updates from '../data/l_updates.json';
import UpdateHistory from './UpdateHistoryView.astro';

const formatUpdateDate = (date: string) => {
	const parts = new Intl.DateTimeFormat('ja-JP', {
		year: 'numeric',
		month: 'numeric',
		day: 'numeric',
		timeZone: 'Asia/Tokyo',
	}).formatToParts(new Date(date));
	const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
	return `${values.year}/${values.month}/${values.day}`;
};

const latestUpdate = updates.at(-1);
const updatedDate = latestUpdate?.updatedDate
	? formatUpdateDate(latestUpdate.updatedDate)
	: '';
---
<header class="header">
	<div class="header-content">
		<strong class="site-title">#コンパス デッキシミュレーター</strong>
		<div class="header-actions">
			<div class="updates-control">
				<button class="updates-button" type="button">更新履歴</button>
				<span class="update-date" aria-label="サイトの最終更新日">最終更新日：{updatedDate}</span>
			</div>
		</div>
	</div>
	<UpdateHistory />
</header>
