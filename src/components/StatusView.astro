---
import '../styles/status-view.css';
import { getAllCard, getCardStatusDisplayByCardId } from "../accessors/cards/getData";
import { getAllHeroStatus } from "../accessors/heros/getData.ts";
import heroMedalStats from "../data/heros/m_hero_medal_stats.json";
import cardLevelStatuses from "../data/cards/m_card_level_statuses.json";
import { HeroMedalType } from "../types/heros";

const cards = getAllCard();
const levelOptions = [1, 20, 30, 40, 50, 60];

const initialCards = [...cards]
  .sort((a, b) => a.id - b.id)
  .slice(0, 4);

const maxAttack = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).attack ?? 0), 0);
const maxDefense = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).defense ?? 0), 0);
const maxHealth = Math.max(...cards.map((card) => getCardStatusDisplayByCardId(card.id, 60).health ?? 0), 0);
const cardLevelStatusMapById = Object.fromEntries(
  cardLevelStatuses.map((row) => [row.card_id, row])
);
const maximums = { attack: maxAttack * 10, defense: maxDefense * 10, health: maxHealth * 10 };
const cardLevelStatusMap = Object.fromEntries(
  cards.map((card) => [
    card.id,
    Object.fromEntries(levelOptions.map((level) => [String(level), getCardStatusDisplayByCardId(card.id, level)])),
  ])
);

const getTeamLevelMultiplier = (key: "attack" | "defense" | "health", level: number) => {
  if (level <= 1) {
    return 1;
  }

  const rate = key === "attack" ? 0.1 : 0.15;
  return 1 + (rate * (level - 1) / 8);
};

const getTeamLevelAdjustedValue = (key: "attack" | "defense" | "health", level: number, value: number) => {
  return Math.round(Number(value ?? 0) * getTeamLevelMultiplier(key, level));
};

const getStatusTotals = (cardIds: number[], levelByCardId: Record<number, number> = {}, teamLevel = 1) => cardIds.reduce(
  (totals, cardId) => {
    const level = levelByCardId[cardId] ?? 1;
    const status = getCardStatusDisplayByCardId(cardId, level);

    totals.attack += getTeamLevelAdjustedValue("attack", teamLevel, status?.attack ?? 0);
    totals.defense += getTeamLevelAdjustedValue("defense", teamLevel, status?.defense ?? 0);
    totals.health += getTeamLevelAdjustedValue("health", teamLevel, status?.health ?? 0);
    return totals;
  },
  { attack: 0, defense: 0, health: 0 },
);

const initialTotals = getStatusTotals(initialCards.map((card) => card.id));
const getGaugePercent = (value: number, maxValue: number) => {
  if (!maxValue) return 0;
  return Math.min(100, Math.round((value / maxValue) * 100));
};

const heroStatusMap = Object.fromEntries(getAllHeroStatus().map((row) => [row.id, row]));
const rangeMaxByKey = {
  attack: maximums.attack,
  defense: maximums.defense,
  health: maximums.health,
};

const statuses = [
  {
    name: "攻撃",
    key: "attack",
    value: initialTotals.attack,
    green: getGaugePercent(initialTotals.attack, maximums.attack),
    red: 0,
  },
  {
    name: "防御",
    key: "defense",
    value: initialTotals.defense,
    green: getGaugePercent(initialTotals.defense, maximums.defense),
    red: 0,
  },
  {
    name: "体力",
    key: "health",
    value: initialTotals.health,
    green: getGaugePercent(initialTotals.health, maximums.health),
    red: 0,
  },
];

---

<div class="status-view">
  <div class="status-view-content">
    <div class="status-title">
      ■ デッキ総合力
    </div>

    <div class="status-list-panel">
      {statuses.map((status) => (
        <div
          class="status"
          data-status-key={status.key}
          style={`--green:${status.green}%; --red:${status.red}%;`}
        >
          <div class="status-name">
            {status.name}
          </div>

          <div class="status-gauge">
            <div class="status-gauge-green"></div>
            <div class="status-gauge-diff"></div>
            <div class="status-gauge-text">
              <span class="status-value">{status.value}</span>
              <span class="status-default">（{maximums[status.key as keyof typeof maximums]}）</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ initialTotals, maximums, cardLevelStatusMap: cardLevelStatusMap, heroStatusMap: heroStatusMap, heroMedalStats, cardLevelStatuses, heroMedalTypeIds: { attack: HeroMedalType.ATK_UP, defense: HeroMedalType.DEF_UP, health: HeroMedalType.HP_UP } }}>
  const heroMedalStatRows = Array.isArray(heroMedalStats) ? heroMedalStats : [];
  const cardLevelStatusRows = Array.isArray(cardLevelStatuses) ? cardLevelStatuses : [];

  const getMedalPercentTotal = (medalTypeId) => {
    const medalIcons = Array.from(document.querySelectorAll("#medal-settings .medal-icon"));

    return medalIcons.reduce((totalPercent, icon) => {
      const medalType = Number(icon.getAttribute("data-medal-type") ?? 0);
      const medalLevel = Number(icon.getAttribute("data-medal-level") ?? 1);
      const medalColor = Number(icon.getAttribute("data-medal-color") ?? 0);

      if (medalType !== medalTypeId) {
        return totalPercent;
      }

      const sameColorCount = medalIcons.reduce((count, candidate) => {
        const candidateColor = Number(candidate.getAttribute("data-medal-color") ?? 0);
        return count + (candidateColor === medalColor ? 1 : 0);
      }, 0);

      const matchedStat = heroMedalStatRows.find((row) => {
        return row.heroMedalId === medalType && row.level === medalLevel && row.count === sameColorCount;
      });

      return totalPercent + (matchedStat?.percent ?? 0);
    }, 0);
  };

  const getBaseStatusValue = (cardId, level, key) => {
    const normalizedLevel = Number(level ?? 1);
    const exactStatus = cardLevelStatusMap?.[cardId]?.[String(normalizedLevel)] ?? null;
    const exactLevelStatusRow = cardLevelStatusRows.find((row) => row.card_id === cardId && row.level === normalizedLevel);
    const fallbackStatus = cardLevelStatusMap?.[cardId]?.["1"] ?? null;
    const fallbackLevelStatusRow = cardLevelStatusRows.find((row) => row.card_id === cardId && row.level === 1);

    if (key === "attack") {
      return exactLevelStatusRow?.attack ?? exactStatus?.attack ?? fallbackLevelStatusRow?.attack ?? fallbackStatus?.attack ?? 0;
    }
    if (key === "defense") {
      return exactLevelStatusRow?.defense ?? exactStatus?.defense ?? fallbackLevelStatusRow?.defense ?? fallbackStatus?.defense ?? 0;
    }
    return exactLevelStatusRow?.health ?? exactStatus?.health ?? fallbackLevelStatusRow?.health ?? fallbackStatus?.health ?? 0;
  };

  const getStatusTotals = (cardIds, levelByCardId = {}, teamLevel = 1) => cardIds.reduce(
    (totals, cardId) => {
      const level = Number(levelByCardId[cardId] ?? 1);
      const attackValue = getBaseStatusValue(cardId, level, "attack");
      const defenseValue = getBaseStatusValue(cardId, level, "defense");
      const healthValue = getBaseStatusValue(cardId, level, "health");

      totals.attack += Math.round(Number(attackValue ?? 0) * (teamLevel <= 1 ? 1 : 1 + (0.1 * (teamLevel - 1) / 8)));
      totals.defense += Math.round(Number(defenseValue ?? 0) * (teamLevel <= 1 ? 1 : 1 + (0.15 * (teamLevel - 1) / 8)));
      totals.health += Math.round(Number(healthValue ?? 0) * (teamLevel <= 1 ? 1 : 1 + (0.15 * (teamLevel - 1) / 8)));
      return totals;
    },
    { attack: 0, defense: 0, health: 0 },
  );

  let selectedHeroFactors = null;
  let latestTotals = { ...initialTotals };

  const getGaugePercent = (value, maxValue) => {
    if (!maxValue) return 0;
    return Math.min(100, Math.round((value / maxValue) * 100));
  };

  const updateStatusValues = (totals) => {
    latestTotals = { ...totals };

    document.querySelectorAll(".status-view .status[data-status-key]").forEach((statusElement) => {
      const key = statusElement.dataset.statusKey;
      const maxValue = maximums[key] ?? 0;
      const baseValue = totals[key] ?? 0;
      const heroFactor = selectedHeroFactors ? selectedHeroFactors[key] ?? 1 : null;

      const medalTypeId = heroMedalTypeIds[key] ?? 0;
      const medalPercentTotal = getMedalPercentTotal(medalTypeId);
      const percentageMultiplier = 1 + (medalPercentTotal / 100);
      const rawValue = heroFactor != null
        ? baseValue * heroFactor * percentageMultiplier
        : baseValue;
      const displayedValue = Math.round(rawValue);

      const valueElement = statusElement.querySelector(".status-value");
      const defaultElement = statusElement.querySelector(".status-default");
      const greenElement = statusElement.querySelector(".status-gauge-green");
      const diffElement = statusElement.querySelector(".status-gauge-diff");

      if (valueElement) {
        valueElement.textContent = String(displayedValue);
        valueElement.classList.toggle("status-value-positive", displayedValue > baseValue);
        valueElement.classList.toggle("status-value-negative", displayedValue < baseValue);
        valueElement.classList.toggle("status-value-neutral", displayedValue === baseValue);
      }
      if (defaultElement) {
        defaultElement.textContent = `（${baseValue}）`;
      }

      const basePercent = getGaugePercent(baseValue, maxValue);
      const displayedPercent = getGaugePercent(displayedValue, maxValue);
      const gaugeWidth = displayedPercent;

      if (greenElement) {
        greenElement.style.width = `${gaugeWidth}%`;
      }

      if (diffElement) {
        if (displayedValue > baseValue) {
          const deltaPercent = displayedPercent - basePercent;
          diffElement.style.left = `${basePercent}%`;
          diffElement.style.width = `${Math.max(0, deltaPercent)}%`;
          diffElement.style.background = "linear-gradient(90deg, #4ade80, #22c55e)";
          diffElement.style.opacity = "1";
        } else if (displayedValue < baseValue) {
          const deltaPercent = basePercent - displayedPercent;
          diffElement.style.left = `${displayedPercent}%`;
          diffElement.style.width = `${Math.max(0, deltaPercent)}%`;
          diffElement.style.background = "linear-gradient(90deg, #f87171, #ef4444)";
          diffElement.style.opacity = "1";
        } else {
          diffElement.style.left = "0%";
          diffElement.style.width = "0%";
          diffElement.style.opacity = "0";
        }
      }
    });
  };

  updateStatusValues(initialTotals);

  document.addEventListener("deck-view:state-changed", (event) => {
    const cardLevels = event.detail?.cardLevels ?? [];
    const levelByCardId = Object.fromEntries(cardLevels.map((item) => [item.cardId, item.level]));
    const teamLevel = Number(event.detail?.teamLevel ?? 1);
    const totals = event.detail?.totals ?? getStatusTotals(event.detail?.cardIds ?? [], levelByCardId, teamLevel);

    latestTotals = { ...totals };
    updateStatusValues(totals);
  });

  document.addEventListener("footer:hero-selected", (event) => {
    const heroId = Number(event.detail?.heroId ?? 0);
    const factors = event.detail?.factors ?? null;
    const heroStatus = heroStatusMap?.[heroId] ?? null;

    if (heroStatus && factors) {
      selectedHeroFactors = {
        attack: factors.attack ?? heroStatus.attack ?? 1,
        defense: factors.defense ?? heroStatus.defense ?? 1,
        health: factors.health ?? heroStatus.health ?? 1,
      };
    } else {
      selectedHeroFactors = null;
    }

    updateStatusValues(latestTotals);
  });

  document.addEventListener("medal-settings:changed", () => {
    updateStatusValues(latestTotals);
  });
</script>
